+/* Glassmorphism utilities */
+@layer utilities {
+  .glass {
+    @apply bg-background bg-opacity-60 backdrop-blur-xl border border-border shadow-sm;
+  }
+  .glass-card {
+    @apply bg-card bg-opacity-60 backdrop-blur-xl border border-border shadow-[0_8px_30px_rgb(0,0,0,0.04)];
+  }
+  .glass-dark {
+    @apply bg-black bg-opacity-40 backdrop-blur-2xl border border-white border-opacity-10;
+  }
+
+  /* Custom scrollbar for better UI feel */
+  .custom-scrollbar::-webkit-scrollbar {
+    width: 6px;
+    height: 6px;
+  }
+  .custom-scrollbar::-webkit-scrollbar-track {
+    background: transparent;
+  }
+  .custom-scrollbar::-webkit-scrollbar-thumb {
+    @apply bg-muted-foreground bg-opacity-20 rounded-full;
+  }
+  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
+    @apply bg-muted-foreground bg-opacity-40;
+  }
+}
