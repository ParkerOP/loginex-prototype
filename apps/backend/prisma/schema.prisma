// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  vehicles Vehicle[]
}

model User {
  id             String        @id @default(uuid())
  phone          String        @unique
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  role           String        @default("SHIPPER") // SHIPPER, DRIVER, ADMIN
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  shipperProfile ShipperProfile?
  driverProfile  DriverProfile?
  disputes       Dispute[]
}

model ShipperProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  gstin     String?
  planType  String   @default("FREE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loads   Load[]
  ratings Rating[]
  Invoice Invoice[]
}

model DriverProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  name          String
  licenseNumber String?
  trustScore    Float    @default(5.0)
  planType      String   @default("FREE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicles         Vehicle[]
  matchSuggestions MatchSuggestion[]
  bookings         Booking[]
  trips            Trip[]
  ratings          Rating[]
}

model Vehicle {
  id              String         @id @default(uuid())
  registrationNo  String         @unique
  type            String // TATA_ACE, 14_FT, etc.
  organizationId  String?
  organization    Organization?  @relation(fields: [organizationId], references: [id])
  driverProfileId String?
  driverProfile   DriverProfile? @relation(fields: [driverProfileId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Load {
  id                  String         @id @default(uuid())
  shipperId           String
  shipper             ShipperProfile @relation(fields: [shipperId], references: [id])
  originAddress       String
  originCity          String // For simple matching
  destinationAddress  String
  destinationCity     String
  cargoDescription    String
  requiredVehicleType String
  weight              Float?
  scheduledTime       DateTime
  specialInstructions String?
  status              String         @default("POSTED") // POSTED, MATCHING, BOOKED, IN_TRANSIT, DELIVERED, CANCELLED
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  matchSuggestions MatchSuggestion[]
  booking          Booking?
}

model MatchSuggestion {
  id        String        @id @default(uuid())
  loadId    String
  load      Load          @relation(fields: [loadId], references: [id])
  driverId  String
  driver    DriverProfile @relation(fields: [driverId], references: [id])
  score     Float
  status    String        @default("OFFERED") // OFFERED, ACCEPTED, REJECTED, EXPIRED
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([loadId, driverId])
}

model Booking {
  id        String        @id @default(uuid())
  loadId    String        @unique
  load      Load          @relation(fields: [loadId], references: [id])
  driverId  String
  driver    DriverProfile @relation(fields: [driverId], references: [id])
  status    String        @default("CONFIRMED") // CONFIRMED, COMPLETED, CANCELLED
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  trip Trip?
}

model Trip {
  id                String             @id @default(uuid())
  bookingId         String             @unique
  booking           Booking            @relation(fields: [bookingId], references: [id])
  driverId          String
  driver            DriverProfile      @relation(fields: [driverId], references: [id])
  status            String             @default("STARTED") // STARTED, IN_TRANSIT, ARRIVED, DELIVERED
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  locationPings     LocationPing[]
  proofOfDelivery   ProofOfDelivery?
  platformFeeRecord PlatformFeeRecord?
  disputes          Dispute[]
  invoice           Invoice?
  rating            Rating?
}

model LocationPing {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  latitude  Float
  longitude Float
  accuracy  Float?
  createdAt DateTime @default(now())
}

model ProofOfDelivery {
  id        String   @id @default(uuid())
  tripId    String   @unique
  trip      Trip     @relation(fields: [tripId], references: [id])
  imageUrl  String
  notes     String?
  createdAt DateTime @default(now())
}

model Rating {
  id        String         @id @default(uuid())
  tripId    String         @unique
  trip      Trip           @relation(fields: [tripId], references: [id])
  driverId  String
  driver    DriverProfile  @relation(fields: [driverId], references: [id])
  shipperId String
  shipper   ShipperProfile @relation(fields: [shipperId], references: [id])
  score     Float // e.g., 1 to 5
  comment   String?
  createdAt DateTime       @default(now())
}

model PlatformFeeRecord {
  id        String   @id @default(uuid())
  tripId    String   @unique
  trip      Trip     @relation(fields: [tripId], references: [id])
  amount    Float
  status    String   @default("PENDING") // PENDING, PAID, FAILED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dispute {
  id         String   @id @default(uuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id])
  raisedById String
  raisedBy   User     @relation(fields: [raisedById], references: [id])
  reason     String
  status     String   @default("OPEN") // OPEN, IN_REVIEW, RESOLVED
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Invoice {
  id        String         @id @default(uuid())
  tripId    String         @unique
  trip      Trip           @relation(fields: [tripId], references: [id])
  shipperId String
  shipper   ShipperProfile @relation(fields: [shipperId], references: [id])
  amount    Float
  status    String         @default("ISSUED") // ISSUED, PAID, CANCELLED
  fileUrl   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}
